{
  "name": "marketing-task-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:firebase-access": "node scripts/check-firestore-access.mjs",
    "test:legacy": "node --test server/smoke.test.js",
    "test:rules": "node scripts/run-rules-tests.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.3.1",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@vercel/oidc": "^4.0.0",
    "firebase": "^13.0.0",
    "firebase-admin": "14.5.0",
    "google-auth-library": "^11.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": { "@grpc/grpc-js": "1.14.6" },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.3"
  }
